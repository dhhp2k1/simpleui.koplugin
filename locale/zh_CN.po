#: modules/critter/voice_phrases.lua:391
msgid "%s feels abandoned."
msgstr "《%s》觉得被抛弃了。"

#: modules/critter/voice_phrases.lua:129
msgid "%s is untouched. Good."
msgstr "《%s》还没动过。很好。"

#: modules/critter/voice_phrases.lua:303
msgid "%s is waiting. I know how it is."
msgstr "《%s》在等你。我懂那种感觉。"

#: modules/critter/voice_phrases.lua:654
msgid "%s is waiting. I know waiting!"
msgstr "《%s》在等你。我最懂等待！"

#: modules/critter/voice_phrases.lua:478
msgid "%s waits. As do I."
msgstr "《%s》在等。我也在等。"

#: modules/critter/voice_phrases.lua:740
msgid "%s waits. I charmed your place."
msgstr "《%s》在等你。我给书签施了咒。"

#: modules/critter/voice_phrases.lua:650
msgid "%s! Does the dog live?"
msgstr "《%s》！狗狗活下来了吗？"

#: modules/critter/voice_phrases.lua:736
msgid "%s! Does the witch win?"
msgstr "《%s》！女巫赢了吗？"

#: modules/critter/voice_phrases.lua:387
msgid "%s! Is the monster misunderstood?"
msgstr "《%s》！怪物是被误解了吗？"

#: modules/critter/voice_phrases.lua:562
msgid "%s, %d%%. I know the ending."
msgstr "《%s》，%d%%。我知道结局。"

#: modules/critter/voice_phrases.lua:566
msgid "%s, untouched. The dust agrees."
msgstr "《%s》，没动过。灰尘可以作证。"

#: modules/critter/voice_phrases.lua:299
msgid "%s. Does anyone go mad?"
msgstr "《%s》。有人发疯吗？"

#: modules/critter/voice_phrases.lua:474
msgid "%s. Is there garlic in it?"
msgstr "《%s》。里面有大蒜吗？"

#: modules/critter/voice_phrases.lua:125
msgid "%s? I've read the cover."
msgstr "《%s》？我读过封面了。"

#: modules/critter/voice_phrases.lua:212
msgid "%s? Is there a cat in it?"
msgstr "《%s》？里面有猫吗？"

#: modules/critter/voice_phrases.lua:539
msgid "A busy week, I deduce."
msgstr "我推断，这周很忙。"

#: modules/critter/voice_phrases.lua:567
msgid "A cold case."
msgstr "一桩悬案。"

#: modules/critter/game_lines.lua:34
msgid "A draw! We think alike."
msgstr "平局！我们想到一块儿了。"

#: modules/critter/game_lines.lua:32
msgid "A draw."
msgstr "平局。"

#: modules/critter/game_lines.lua:33
msgid "A draw. Boring."
msgstr "平局。真无聊。"

#: modules/critter/voice_phrases.lua:288
msgid "A very good eyeblink."
msgstr "一眨眼的好时光。"

#: modules/critter/voice_phrases.lua:601
msgid "Afternoon! I found a stick!"
msgstr "下午好！我捡到一根棍子！"

#: modules/critter/voice_phrases.lua:338
msgid "Afternoon! I'm full of energy."
msgstr "下午好！我浑身是劲。"

#: modules/critter/voice_phrases.lua:689
msgid "Afternoon! The cat's been a crow all day."
msgstr "下午好！猫变成乌鸦一整天了。"

#: modules/critter/voice_phrases.lua:426
msgid "Afternoon. I'm technically asleep."
msgstr "下午了。理论上我在睡觉。"

#: modules/critter/voice_phrases.lua:164
msgid "Afternoon. My fans want an update."
msgstr "下午了。我的粉丝等着更新。"

#: modules/critter/voice_phrases.lua:513
msgid "Afternoon. You've just had lunch."
msgstr "下午了。你刚吃过午饭。"

#: modules/critter/voice_phrases.lua:639
msgid "Almost the whole time!"
msgstr "几乎全程都在！"

#: modules/critter/voice_phrases.lua:209
msgid "And a tiara. Just saying."
msgstr "再来顶小王冠。我只是说说。"

#: modules/critter/voice_phrases.lua:433
msgid "And of your own will."
msgstr "还是你自愿的。"

#: modules/critter/game_lines.lua:132
msgid "Another round"
msgstr "再来一局"

#: features/sui_patch_compat.lua:204
msgid "Apply and restart"
msgstr "应用并重启"

#: modules/critter/voice_phrases.lua:300
msgid "Asking for a friend."
msgstr "替朋友问的。"

#: modules/critter/voice_phrases.lua:384
msgid "Assembled from many sources."
msgstr "由许多来源拼凑而成。"

#: infra/sui_config.lua:1559
msgid "Background"
msgstr "背景"

#: modules/critter/voice_phrases.lua:667
msgid "Book, walk, book, walk!"
msgstr "看书，散步，看书，散步！"

#: modules/critter/voice_phrases.lua:725
msgid "Books eat time. Old magic."
msgstr "书会吃掉时间。古老的魔法。"

#: modules/critter/voice_phrases.lua:159
msgid "By the mirror, but still."
msgstr "在镜子旁边，但还是。"

#: modules/critter/voice_phrases.lua:100
msgid "Cats don't do routines."
msgstr "猫不搞什么固定习惯。"

#: features/sui_patch_compat.lua:65
msgid "Changes how books are opened from the file browser"
msgstr "更改从文件浏览器打开书籍的方式"

#: features/sui_patch_compat.lua:46
msgid "Changes the size of the menus or the fonts"
msgstr "更改菜单大小或字体"

#: modules/critter/game_lines.lua:60
msgid "Close! It was %s."
msgstr "差一点！答案是 %s。"

#: modules/critter/game_lines.lua:53
msgid "Correct!"
msgstr "答对了！"

#: modules/critter/game_lines.lua:55
msgid "Correct! You know your books."
msgstr "答对了！你很懂书嘛。"

#: modules/critter/game_lines.lua:54
msgid "Correct. Don't let it go to your head."
msgstr "答对了。别得意忘形。"

#: modules/critter/voice_phrases.lua:514
msgid "Crumbs on the screen."
msgstr "屏幕上有面包屑。"

#: modules/critter/voice_phrases.lua:133
msgid "Daily goal done. Now pet me."
msgstr "今日目标完成。现在摸摸我。"

#: modules/critter/voice_phrases.lua:307
msgid "Daily goal done. The deep is pleased."
msgstr "今日目标完成。深渊很满意。"

#: features/sui_patch_compat.lua:165
msgid "Disable and restart"
msgstr "停用并重启"

#: modules/critter/voice_phrases.lua:232
msgid "Do you think I'm pretty? Correct."
msgstr "你觉得我漂亮吗？答对了。"

#: features/sui_patch_compat.lua:54
msgid "Draws on the book covers without supporting Simple UI"
msgstr "在书籍封面上绘制内容，但不支持 Simple UI"

#: features/sui_patch_compat.lua:50
msgid "Duplicates the author and series browser"
msgstr "与作者和系列浏览器功能重复"

#: modules/critter/voice_phrases.lua:596
msgid "Either! Both! Hi!"
msgstr "都行！都要！嗨！"

#: modules/critter/game_lines.lua:134
msgid "Enough for now"
msgstr "先到这儿吧"

#: modules/critter/voice_phrases.lua:487
msgid "Even I won't bite it."
msgstr "连我都不会去咬它。"

#: modules/critter/voice_phrases.lua:344
msgid "Evening! I learned to talk from books."
msgstr "晚上好！我是从书里学会说话的。"

#: modules/critter/voice_phrases.lua:607
msgid "Evening! I warmed your seat!"
msgstr "晚上好！我帮你把座位捂热了！"

#: modules/critter/voice_phrases.lua:695
msgid "Evening! The candles lit themselves."
msgstr "晚上好！蜡烛自己点亮了。"

#: modules/critter/voice_phrases.lua:170
msgid "Evening. Dim the lamp. I glow."
msgstr "晚上了。把灯调暗。我会发光。"

#: modules/critter/voice_phrases.lua:83
msgid "Evening. I knocked your pen off."
msgstr "晚上了。我把你的笔推下去了。"

#: modules/critter/voice_phrases.lua:519
msgid "Evening. The game is afoot."
msgstr "晚上了。好戏开场了。"

#: modules/critter/voice_phrases.lua:257
msgid "Evening. Your sanity looks well."
msgstr "晚上了。你的理智看起来还好。"

#: modules/critter/voice_phrases.lua:756
msgid "Every book is a spell, you know."
msgstr "每本书都是一道咒语，你知道的。"

#: modules/critter/voice_phrases.lua:138
msgid "Every day is Saturday here."
msgstr "在这儿天天都是星期六。"

#: modules/critter/voice_phrases.lua:628
msgid "Finding is my thing!"
msgstr "找东西是我的强项！"

#: modules/critter/dialog.lua:90
msgid "Fine. More room for me."
msgstr "行吧。我的地盘更大了。"

#: modules/critter/game_lines.lua:80
msgid "Fine. That one can stay."
msgstr "行吧。那句可以留下。"

#: modules/critter/game_lines.lua:66
msgid "Fine. That's enough for me too."
msgstr "行吧。我也玩够了。"

#: modules/critter/voice_phrases.lua:217
msgid "For three minutes. I remember."
msgstr "就三分钟。我记得。"

#: modules/critter/voice_phrases.lua:220
msgid "Goal reached! Do we need a speech?"
msgstr "目标达成！要不要发表感言？"

#: modules/critter/voice_phrases.lua:395
msgid "Goal reached! IT'S ALIVE!"
msgstr "目标达成！它活了！"

#: modules/critter/voice_phrases.lua:744
msgid "Goal reached! Not a single spell."
msgstr "目标达成！一个咒语都没用。"

#: modules/critter/voice_phrases.lua:658
msgid "Goal reached! Treat? Treat for you?"
msgstr "目标达成！零食？给你零食？"

#: modules/critter/voice_phrases.lua:482
msgid "Goal reached. Sinister efficiency."
msgstr "目标达成。效率高得吓人。"

#: modules/critter/voice_phrases.lua:570
msgid "Goal reached. You have a method."
msgstr "目标达成。你很有章法。"

#: modules/critter/game_lines.lua:65
msgid "Good game. Same time tomorrow?"
msgstr "玩得开心。明天同一时间？"

#: modules/critter/game_lines.lua:95
msgid "Guess the author"
msgstr "猜作者"

#: modules/critter/voice_phrases.lua:177
msgid "He ate a bookmark. Ignore it."
msgstr "他吃了张书签。别管他。"

#: modules/critter/game_lines.lua:108
msgid "Heads"
msgstr "正面"

#: modules/critter/game_lines.lua:94
msgid "Heads or tails"
msgstr "猜正反面"

#: modules/critter/voice_phrases.lua:345
msgid "Hence the vocabulary."
msgstr "所以才有这么多词汇。"

#: features/sui_patch_compat.lua:61
msgid "Hides Wi-Fi dialogs, and any other dialog that mentions Wi-Fi"
msgstr "隐藏 Wi-Fi 对话框，以及任何提到 Wi-Fi 的对话框"

#: modules/critter/game_lines.lua:79
msgid "Hm. I've read worse."
msgstr "嗯。我读过更糟的。"

#: modules/critter/voice_phrases.lua:483
msgid "I admire it."
msgstr "我很欣赏。"

#: modules/critter/voice_phrases.lua:670
msgid "I brought you your book!"
msgstr "我把你的书叼来了！"

#: modules/critter/voice_phrases.lua:624
msgid "I can't count. I'm proud!"
msgstr "我不会数数。我好骄傲！"

#: modules/critter/voice_phrases.lua:251
msgid "I dreamt of my sunken city again."
msgstr "我又梦见我沉没的城市了。"

#: modules/critter/voice_phrases.lua:225
msgid "I have people for that."
msgstr "这种事有人替我做。"

#: modules/critter/voice_phrases.lua:663
msgid "I love all the days!"
msgstr "每一天我都爱！"

#: modules/critter/game_lines.lua:67
msgid "I love playing with you."
msgstr "我好喜欢和你玩。"

#: modules/critter/voice_phrases.lua:463
msgid "I mean the prose."
msgstr "我是说文笔。"

#: modules/critter/voice_phrases.lua:655
msgid "I once waited twenty years."
msgstr "我曾经等过二十年。"

#: modules/critter/voice_phrases.lua:147
msgid "I pushed your bookmark off the shelf."
msgstr "我把你的书签推下书架了。"

#: modules/critter/voice_phrases.lua:312
msgid "I quite like it."
msgstr "我还挺喜欢的。"

#: modules/critter/voice_phrases.lua:407
msgid "I read Paradise Lost once."
msgstr "我读过一次《失乐园》。"

#: modules/critter/voice_phrases.lua:558
msgid "I read the last page first."
msgstr "我先看最后一页。"

#: modules/critter/voice_phrases.lua:122
msgid "I sat on every one, though."
msgstr "不过每本我都坐过。"

#: modules/critter/voice_phrases.lua:321
msgid "I speak many unspeakable tongues."
msgstr "我会说许多不可名状的语言。"

#: modules/critter/voice_phrases.lua:304
msgid "I waited aeons. It's fine."
msgstr "我等了无数个纪元。没事。"

#: modules/critter/game_lines.lua:88
msgid "I want to frame that one."
msgstr "这句我想裱起来。"

#: modules/critter/game_lines.lua:29
msgid "I win! Want to try again?"
msgstr "我赢了！要再试一次吗？"

#: modules/critter/game_lines.lua:27
msgid "I win."
msgstr "我赢了。"

#: modules/critter/game_lines.lua:28
msgid "I win. Obviously."
msgstr "我赢了。理所当然。"

#: modules/critter/voice_phrases.lua:563
msgid "I won't tell. Probably."
msgstr "我不会说出去的。大概。"

#: modules/critter/voice_phrases.lua:186
msgid "I'd know. I'm a Grand Champion."
msgstr "我当然知道。我可是总冠军。"

#: modules/critter/voice_phrases.lua:497
msgid "I'll be borrowing it."
msgstr "我要借走了。"

#: modules/critter/voice_phrases.lua:421
msgid "I'll be in the shade. Reading."
msgstr "我去阴凉处。读书。"

#: modules/critter/voice_phrases.lua:221
msgid "I'll do the speech."
msgstr "感言我来发表。"

#: modules/critter/voice_phrases.lua:659
msgid "I'll hold it for you."
msgstr "我帮你拿着。"

#: modules/critter/game_lines.lua:73
msgid "I'll keep that one on the shelf."
msgstr "这句我会摆在书架上。"

#: modules/critter/voice_phrases.lua:550
msgid "I'll say nothing. Mostly."
msgstr "我什么也不说。大体上。"

#: modules/critter/voice_phrases.lua:475
msgid "I'll skip those pages."
msgstr "那几页我就跳过了。"

#: modules/critter/game_lines.lua:75
msgid "I'll think about that all night."
msgstr "这句我会想一整晚。"

#: modules/critter/game_lines.lua:98
msgid "I'm flipping. Call it."
msgstr "我抛了。你猜。"

#: modules/critter/voice_phrases.lua:471
msgid "I'm on my fourth century."
msgstr "我已经活到第四个世纪了。"

#: modules/critter/voice_phrases.lua:361
msgid "I'm six different people."
msgstr "我是六个不同的人拼的。"

#: modules/critter/voice_phrases.lua:365
msgid "I'm very good at it."
msgstr "我非常擅长。"

#: modules/critter/voice_phrases.lua:696
msgid "I've been practising."
msgstr "我一直在练习。"

#: modules/critter/voice_phrases.lua:130
msgid "I've been sleeping on it."
msgstr "我一直枕着它睡。"

#: modules/critter/voice_phrases.lua:145
msgid "I've been staring at you for an hour."
msgstr "我已经盯着你看了一小时。"

#: modules/critter/voice_phrases.lua:571
msgid "I've been studying it."
msgstr "我一直在研究它。"

#: modules/critter/voice_phrases.lua:400
msgid "I've had a few."
msgstr "我有过几个。"

#: modules/critter/voice_phrases.lua:77
msgid "I've ignored you since noon."
msgstr "我从中午起就没理你。"

#: modules/critter/voice_phrases.lua:494
msgid "I've never seen myself read."
msgstr "我从没见过自己读书。"

#: modules/critter/voice_phrases.lua:479
msgid "I've practised for centuries."
msgstr "我练习了好几个世纪。"

#: features/sui_patch_compat.lua:217
msgid "Incompatible patches"
msgstr "不兼容的补丁"

#: modules/critter/voice_phrases.lua:749
msgid "It came back. They always do."
msgstr "它又回来了。它们总会回来。"

#: modules/critter/voice_phrases.lua:408
msgid "It explained a lot."
msgstr "这解释了很多事。"

#: modules/critter/voice_phrases.lua:252
msgid "It had a lovely library."
msgstr "那里有座很美的图书馆。"

#: modules/critter/voice_phrases.lua:608
msgid "It only smells a little."
msgstr "只有一点点味道。"

#: modules/critter/game_lines.lua:58
msgid "It was %s."
msgstr "答案是 %s。"

#: modules/critter/voice_phrases.lua:333
msgid "It wasn't always mine."
msgstr "它原本不全是我的。"

#: modules/critter/voice_phrases.lua:671
msgid "It's a bit wet. Sorry."
msgstr "有点湿。抱歉。"

#: modules/critter/voice_phrases.lua:602
msgid "It's a bookmark now."
msgstr "现在它是书签了。"

#: modules/critter/voice_phrases.lua:146
msgid "It's a compliment. Probably."
msgstr "这是夸你。大概。"

#: modules/critter/voice_phrases.lua:264
msgid "It's me. I'm stretching."
msgstr "是我。我在伸懒腰。"

#: modules/critter/voice_phrases.lua:684
msgid "It's much quieter now."
msgstr "现在安静多了。"

#: modules/critter/voice_phrases.lua:72
msgid "It's warm now. You're welcome."
msgstr "现在暖和了。不客气。"

#: modules/critter/voice_phrases.lua:491
msgid "Join me. Bring a book."
msgstr "来陪我。带本书。"

#: modules/critter/voice_phrases.lua:647
msgid "Just the corners?"
msgstr "只要边角？"

#: features/sui_patch_compat.lua:166
msgid "Keep and restart"
msgstr "保留并重启"

#: modules/critter/voice_phrases.lua:114
msgid "Kindly. Don't get used to it."
msgstr "好心而已。别习惯了。"

#: modules/critter/voice_phrases.lua:316
msgid "Leave the shallows to others."
msgstr "浅滩就留给别人吧。"

#: modules/critter/dialog.lua:689
msgid "Let's play"
msgstr "来玩吧"

#: modules/critter/voice_phrases.lua:258
msgid "Let's spend a little of it."
msgstr "我们花一点点吧。"

#: modules/critter/voice_phrases.lua:438
msgid "Listen. The children of the night."
msgstr "听。暗夜之子。"

#: modules/critter/voice_phrases.lua:339
msgid "Literally. There was lightning."
msgstr "字面意思。当时真有闪电。"

#: modules/critter/voice_phrases.lua:376
msgid "Long story."
msgstr "说来话长。"

#: modules/critter/voice_phrases.lua:690
msgid "Long story. Read?"
msgstr "说来话长。读书吗？"

#: modules/critter/game_lines.lua:41
msgid "Lucky guess."
msgstr "蒙对了。"

#: modules/critter/voice_phrases.lua:595
msgid "MORNING! Is it a walk? A book?"
msgstr "早上好！是散步？还是读书？"

#: modules/critter/voice_phrases.lua:733
msgid "Mine's mostly recipes."
msgstr "我的大多是食谱。"

#: modules/critter/voice_phrases.lua:495
msgid "Mirrors. Long story."
msgstr "镜子。说来话长。"

#: modules/critter/voice_phrases.lua:399
msgid "Monday! A fresh start. I love those."
msgstr "星期一！新的开始。我好喜欢。"

#: modules/critter/voice_phrases.lua:662
msgid "Monday! I love Mondays!"
msgstr "星期一！我爱星期一！"

#: modules/critter/voice_phrases.lua:574
msgid "Monday. A day of small mysteries."
msgstr "星期一。充满小谜团的一天。"

#: modules/critter/voice_phrases.lua:486
msgid "Monday. A dreadful invention."
msgstr "星期一。可怕的发明。"

#: modules/critter/voice_phrases.lua:311
msgid "Monday. A small, ordinary horror."
msgstr "星期一。一种小小的日常恐怖。"

#: modules/critter/voice_phrases.lua:224
msgid "Monday. I don't do Mondays."
msgstr "星期一。我不过星期一。"

#: modules/critter/voice_phrases.lua:748
msgid "Monday. I tried a spell to skip it."
msgstr "星期一。我试过用咒语跳过它。"

#: modules/critter/voice_phrases.lua:137
msgid "Monday. Irrelevant to cats."
msgstr "星期一。和猫无关。"

#: modules/critter/voice_phrases.lua:234
msgid "Mongo, NO. Not the bookmarks."
msgstr "蒙戈，不行！别碰书签。"

#: modules/critter/voice_phrases.lua:683
msgid "Morning! I turned the alarm into a toad."
msgstr "早上好！我把闹钟变成了蛤蟆。"

#: modules/critter/voice_phrases.lua:158
msgid "Morning! I've already been adored."
msgstr "早上好！我已经被崇拜过了。"

#: modules/critter/voice_phrases.lua:332
msgid "Morning! My left hand woke up first."
msgstr "早上好！我的左手先醒了。"

#: modules/critter/voice_phrases.lua:71
msgid "Morning. I slept on your book."
msgstr "早上了。我睡在你的书上。"

#: modules/critter/voice_phrases.lua:245
msgid "Morning. The stars are not yet right."
msgstr "早上了。星辰尚未归位。"

#: modules/critter/voice_phrases.lua:507
msgid "Morning. Two coffees already."
msgstr "早上好。已经两杯咖啡了。"

#: modules/critter/voice_phrases.lua:420
msgid "Morning. Who opened the blinds?"
msgstr "早上了。谁拉开的百叶窗？"

#: modules/critter/voice_phrases.lua:575
msgid "Mostly missing socks."
msgstr "多半是丢失的袜子。"

#: modules/critter/voice_phrases.lua:126
msgid "Mostly with my face."
msgstr "主要是用脸。"

#: modules/critter/voice_phrases.lua:233
msgid "Moving on."
msgstr "说正事。"

#: modules/critter/voice_phrases.lua:758
msgid "My hat's been talking about you."
msgstr "我的帽子一直在念叨你。"

#: modules/critter/voice_phrases.lua:409
msgid "My stitches itch when you're away."
msgstr "你不在时，我的缝线会痒。"

#: modules/critter/voice_phrases.lua:759
msgid "Nice things. Mostly."
msgstr "好东西。大部分是。"

#: modules/critter/voice_phrases.lua:701
msgid "Night! Broom parked, hat off."
msgstr "晚安！扫帚停好，帽子摘下。"

#: modules/critter/voice_phrases.lua:350
msgid "Night! Dark and stormy. My kind."
msgstr "晚安！月黑风高。我喜欢。"

#: modules/critter/voice_phrases.lua:613
msgid "Night! I heard a noise! It was me."
msgstr "晚安！我听到声音！原来是我。"

#: modules/critter/voice_phrases.lua:89
msgid "Night. I start sprinting at three."
msgstr "夜深了。我三点开始疯跑。"

#: modules/critter/voice_phrases.lua:176
msgid "Night. Mongo is guarding the shelf."
msgstr "夜深了。蒙戈在守书架。"

#: modules/critter/voice_phrases.lua:525
msgid "Night. Someone sleeps nearby."
msgstr "夜深了。有人在附近沉睡。"

#: modules/critter/voice_phrases.lua:263
msgid "Night. Something vast stirs."
msgstr "夜深了。某种庞然之物在骚动。"

#: modules/critter/voice_phrases.lua:535
msgid "No bricks without clay."
msgstr "没有黏土就砌不成砖。"

#: modules/critter/game_lines.lua:45
msgid "Not this time."
msgstr "这次不对。"

#: modules/critter/game_lines.lua:47
msgid "Not this time. Again?"
msgstr "这次不对。再来？"

#: modules/critter/voice_phrases.lua:84
msgid "Now there's only the book."
msgstr "现在只剩下书了。"

#: modules/critter/game_lines.lua:83
msgid "Oh, I like that one."
msgstr "哦，我喜欢这句。"

#: modules/critter/dialog.lua:88
msgid "Okay. Another time."
msgstr "好吧。下次吧。"

#: modules/critter/voice_phrases.lua:320
msgid "Old habits."
msgstr "老习惯了。"

#: modules/critter/voice_phrases.lua:453
msgid "One gets used to it."
msgstr "习惯就好。"

#: modules/critter/voice_phrases.lua:520
msgid "Or rather, the book is."
msgstr "或者说，是书在等。"

#: modules/critter/game_lines.lua:106
msgid "Paper"
msgstr "布"

#: modules/critter/voice_phrases.lua:190
msgid "People talk, you know."
msgstr "别人会说闲话的，你知道。"

#: modules/critter/voice_phrases.lua:319
msgid "Ph'nglui… sorry. Hello."
msgstr "弗塔根……抱歉。你好。"

#: modules/critter/voice_phrases.lua:296
msgid "Pity."
msgstr "可惜。"

#: modules/critter/voice_phrases.lua:142
msgid "Plan accordingly."
msgstr "请据此安排。"

#: modules/critter/voice_phrases.lua:651
msgid "Please say the dog lives."
msgstr "拜托告诉我狗狗还活着。"

#: modules/critter/voice_phrases.lua:308
msgid "Rarely. Enjoy it."
msgstr "难得一见。好好享受。"

#: modules/critter/voice_phrases.lua:90
msgid "Read before I do."
msgstr "趁我之前读吧。"

#: modules/critter/voice_phrases.lua:757
msgid "Read it right and things change."
msgstr "读对了，事情就会改变。"

#: modules/critter/voice_phrases.lua:351
msgid "Read me something gothic."
msgstr "给我读点哥特小说。"

#: modules/critter/voice_phrases.lua:579
msgid "Read me something thrilling."
msgstr "给我读点刺激的。"

#: modules/critter/voice_phrases.lua:614
msgid "Read so I calm down."
msgstr "读书吧，让我冷静一下。"

#: modules/critter/voice_phrases.lua:165
msgid "Read something. I'll post it."
msgstr "读点什么。我来发帖。"

#: modules/critter/voice_phrases.lua:78
msgid "Read, and I'll keep it up."
msgstr "你读，我就帮你保持。"

#: features/sui_patch_compat.lua:35
msgid "Replaces the navigation bar or the quick settings"
msgstr "替换导航栏或快捷设置"

#: features/sui_patch_compat.lua:39
msgid "Replaces the title bar"
msgstr "替换标题栏"

#: modules/critter/voice_phrases.lua:711
msgid "Rituals are half of magic."
msgstr "仪式是魔法的一半。"

#: modules/critter/game_lines.lua:105
msgid "Rock"
msgstr "石头"

#: modules/critter/game_lines.lua:93
msgid "Rock, paper, scissors"
msgstr "石头剪刀布"

#: modules/critter/game_lines.lua:97
msgid "Rock, paper, scissors. Go."
msgstr "石头剪刀布。出！"

#: modules/critter/voice_phrases.lua:584
msgid "Rule out the impossible, and…"
msgstr "排除一切不可能，剩下的……"

#: modules/critter/voice_phrases.lua:410
msgid "Science can't explain it."
msgstr "科学解释不了。"

#: modules/critter/game_lines.lua:107
msgid "Scissors"
msgstr "剪刀"

#: modules/critter/dialog.lua:696
msgid "Shall I read you something?"
msgstr "要我给你读点什么吗？"

#: modules/critter/voice_phrases.lua:737
msgid "She'd better."
msgstr "她最好会。"

#: modules/critter/game_lines.lua:76
msgid "Short. Good. My kind of sentence."
msgstr "短。好。我喜欢的句子。"

#: modules/critter/voice_phrases.lua:246
msgid "So, reading it is."
msgstr "那就读书吧。"

#: modules/critter/voice_phrases.lua:278
msgid "Some rise again. Ask me."
msgstr "有些会再次复活。问我就知道。"

#: modules/critter/game_lines.lua:74
msgid "Someone wrote that on purpose."
msgstr "这是有人故意写的。"

#: modules/critter/voice_phrases.lua:396
msgid "Sorry. Family motto."
msgstr "抱歉。家族格言。"

#: modules/critter/voice_phrases.lua:235
msgid "Sorry. He's a growing boy."
msgstr "抱歉。他还在长身体。"

#: modules/critter/voice_phrases.lua:702
msgid "Story time."
msgstr "故事时间。"

#: modules/critter/voice_phrases.lua:364
msgid "Streak broken? I can sew that."
msgstr "连续阅读断了？我能缝好。"

#: modules/critter/game_lines.lua:109
msgid "Tails"
msgstr "反面"

#: modules/critter/game_lines.lua:147
msgid "Thanks"
msgstr "谢谢"

#: modules/critter/game_lines.lua:84
msgid "That one made my day a little bigger."
msgstr "这句让我今天更开阔了一点。"

#: modules/critter/voice_phrases.lua:134
msgid "That was my goal."
msgstr "那正是我的目标。"

#: modules/critter/game_lines.lua:87
msgid "That's beautiful. Read it again?"
msgstr "真美。再读一遍？"

#: modules/critter/voice_phrases.lua:741
msgid "The bookmark won't budge."
msgstr "书签纹丝不动。"

#: modules/critter/voice_phrases.lua:201
msgid "The crowd is me. I'm wild."
msgstr "观众就是我。我超激动。"

#: modules/critter/voice_phrases.lua:627
msgid "The streak ran off! I'll find it!"
msgstr "连续阅读跑掉了！我去找回来！"

#: modules/critter/voice_phrases.lua:583
msgid "The way you hold the device."
msgstr "从你拿设备的姿势。"

#: modules/critter/voice_phrases.lua:213
msgid "There should be. A princess."
msgstr "应该要有。一位公主。"

#: features/sui_patch_compat.lua:151
msgid ""
"These patches clash with Simple UI and can cause crashes or a broken layout."
" The checked ones will be disabled. Uncheck a patch to keep it, at your own "
"risk. A disabled patch can be enabled again in Patch management."
msgstr ""
"这些补丁与 Simple UI 冲突，可能导致崩溃或界面错乱。勾选的补丁将被停用。取消勾选可保留该补丁，风险自负。停用的补丁可在“补丁管理”中重新启用。"

#: modules/critter/voice_phrases.lua:388
msgid "They usually are."
msgstr "通常都是。"

#: modules/critter/voice_phrases.lua:104
msgid "This time."
msgstr "这次而已。"

#: modules/critter/menu.lua:204
msgid "Tiny Critter Settings"
msgstr "迷你小伙伴设置"

#: modules/critter/voice_phrases.lua:449
msgid "Trust me."
msgstr "相信我。"

#: modules/critter/voice_phrases.lua:392
msgid "Trust me. I know the feeling."
msgstr "相信我。我懂那种感觉。"

#: modules/critter/voice_phrases.lua:427
msgid "Turn pages softly."
msgstr "翻页轻一点。"

#: modules/critter/dialog.lua:686
msgid "Want to play something?"
msgstr "想玩点什么吗？"

#: modules/critter/voice_phrases.lua:715
msgid "We just stir again."
msgstr "我们只是再次苏醒。"

#: modules/critter/voice_phrases.lua:666
msgid "Weekend! All day together!"
msgstr "周末！一整天在一起！"

#: modules/critter/voice_phrases.lua:752
msgid "Weekend! Brew tea, read, repeat."
msgstr "周末！泡茶，读书，循环。"

#: modules/critter/voice_phrases.lua:228
msgid "Weekend! Perfect for a photo shoot."
msgstr "周末！最适合拍写真。"

#: modules/critter/voice_phrases.lua:403
msgid "Weekend! Read till my bolts hum."
msgstr "周末！读到我的螺栓嗡嗡响。"

#: modules/critter/voice_phrases.lua:490
msgid "Weekend. Late nights at last."
msgstr "周末。终于可以熬夜了。"

#: modules/critter/voice_phrases.lua:315
msgid "Weekend. Let's not surface at all."
msgstr "周末。我们干脆别浮上去了。"

#: modules/critter/voice_phrases.lua:578
msgid "Weekend. No cases. Dreadfully dull."
msgstr "周末。没有案子。无聊透顶。"

#: modules/critter/voice_phrases.lua:141
msgid "Weekend. Two whole days of lap."
msgstr "周末。整整两天的腿上时光。"

#: modules/critter/voice_phrases.lua:432
msgid "Welcome. Enter freely."
msgstr "欢迎。请自便进来。"

#: modules/critter/voice_phrases.lua:745
msgid "Well. Maybe one."
msgstr "好吧。也许一个。"

#: modules/critter/voice_phrases.lua:439
msgid "What music they make."
msgstr "多美的音乐。"

#: modules/critter/game_lines.lua:92
msgid "What shall we play?"
msgstr "我们玩什么？"

#: modules/critter/game_lines.lua:101
msgid "Who said “%s”?"
msgstr "“%s”是谁说的？"

#: modules/critter/voice_phrases.lua:672
msgid "Who's a good reader? YOU ARE!"
msgstr "谁是好读者？就是你！"

#: modules/critter/voice_phrases.lua:753
msgid "Witch's orders."
msgstr "女巫的命令。"

#: modules/critter/game_lines.lua:59
msgid "Wrong. It was %s."
msgstr "错了。答案是 %s。"

#: modules/critter/game_lines.lua:46
msgid "Wrong. Next."
msgstr "错了。下一个。"

#: modules/critter/voice_phrases.lua:673
msgid "Yes you are!"
msgstr "就是你！"

#: modules/critter/dialog.lua:699
msgid "Yes, please"
msgstr "好呀"

#: modules/critter/voice_phrases.lua:404
msgid "Yes, they're real bolts."
msgstr "对，是真的螺栓。"

#: modules/critter/voice_phrases.lua:216
msgid "You abandoned %s. Like me."
msgstr "你把《%s》抛弃了。像抛弃我一样。"

#: modules/critter/game_lines.lua:42
msgid "You called it! Of course you did."
msgstr "猜中了！果然是你。"

#: modules/critter/game_lines.lua:40
msgid "You called it."
msgstr "猜中了。"

#: modules/critter/voice_phrases.lua:171
msgid "You can read by me."
msgstr "你可以在我旁边读。"

#: modules/critter/voice_phrases.lua:582
msgid "You have been reading, I perceive."
msgstr "我察觉到，你一直在读书。"

#: modules/critter/voice_phrases.lua:229
msgid "You read. I'll pose."
msgstr "你读书。我摆姿势。"

#: modules/critter/voice_phrases.lua:526
msgid "You turn pages so softly."
msgstr "你翻页好轻柔。"

#: modules/critter/game_lines.lua:24
msgid "You win! You're too good."
msgstr "你赢了！你太厉害了。"

#: modules/critter/game_lines.lua:23
msgid "You win. Hmph."
msgstr "你赢了。哼。"

#: modules/critter/game_lines.lua:22
msgid "You win. This time."
msgstr "你赢了。这次而已。"

#: modules/critter/voice_phrases.lua:274
msgid "You, apparently, don't."
msgstr "显然，你不会。"

#: modules/critter/voice_phrases.lua:322
msgid "Your book's one is my favourite."
msgstr "你书里的那个是我的最爱。"

#: modules/critter/voice_phrases.lua:496
msgid "Your neck is safe. Your book isn't."
msgstr "你的脖子安全。你的书可不。"

#: modules/critter/voice_phrases.lua:508
msgid "Your page turns gave it away."
msgstr "你翻页的样子出卖了你。"

#: modules/critter/voice_phrases.lua:148
msgid "Your place is a mystery now."
msgstr "你读到哪儿成了个谜。"

#: modules/critter/voice_phrases.lua:103
msgid "Your streak broke. Not me."
msgstr "你的连续阅读断了。不是我。"

#: modules/critter/voice_phrases.lua:189
msgid "Your streak broke?! How does that LOOK?"
msgstr "连续阅读断了？！这像话吗？"

#: modules/critter/voice_phrases.lua:714
msgid "Your streak fizzled. Potions do too."
msgstr "连续阅读失效了。药水也会。"

#: modules/critter/voice_phrases.lua:277
msgid "Your streak sank. Things do."
msgstr "连续阅读沉了。总会这样。"

#: modules/critter/voice_phrases.lua:538
msgid "Your streak stopped. No foul play."
msgstr "连续阅读停了。并无他杀。"

#: modules/critter/voice_phrases.lua:452
msgid "Your streak vanished. Like my reflection."
msgstr "连续阅读消失了。像我的倒影。"

#: modules/critter/voice_phrases.lua:585
msgid "…what remains is a good book."
msgstr "……剩下的就是一本好书。"

#: modules/critter/voice_phrases.lua:730
msgid "%d book this year! A grimoire's start."
msgid_plural "%d books this year! A whole grimoire."
msgstr[0] "今年读了 %d 本！一整本魔法书。"

#: modules/critter/voice_phrases.lua:381
msgid "%d book this year! Like my brain."
msgid_plural "%d books this year! Like my brain."
msgstr[0] "今年读了 %d 本！像我的脑子。"

#: modules/critter/voice_phrases.lua:468
msgid "%d book this year. A fine start."
msgid_plural "%d books this year. A fine start."
msgstr[0] "今年读了 %d 本。开局不错。"

#: modules/critter/voice_phrases.lua:293
msgid "%d book this year. A forbidden one?"
msgid_plural "%d books this year. Any forbidden?"
msgstr[0] "今年读了 %d 本。有禁书吗？"

#: modules/critter/voice_phrases.lua:119
msgid "%d book this year. I read none."
msgid_plural "%d books this year. I read none."
msgstr[0] "今年读了 %d 本。我一本没读。"

#: modules/critter/voice_phrases.lua:555
msgid "%d book this year. I solved it."
msgid_plural "%d books this year. I solved each."
msgstr[0] "今年读了 %d 本。每本我都破了案。"

#: modules/critter/voice_phrases.lua:644
msgid "%d book! Can I chew the finished one?"
msgid_plural "%d books! Can I chew the finished ones?"
msgstr[0] "%d 本！读完的能给我啃吗？"

#: modules/critter/voice_phrases.lua:206
msgid "%d book! I'd have a sash by now."
msgid_plural "%d books! I'd have a sash by now."
msgstr[0] "%d 本！换我早就拿绶带了。"

#: modules/critter/voice_phrases.lua:709
msgid "%d day! A proper ritual now."
msgid_plural "%d days! A proper ritual now."
msgstr[0] "%d 天！这下是正式仪式了。"

#: modules/critter/voice_phrases.lua:184
msgid "%d day! Champion behaviour."
msgid_plural "%d days! Champion behaviour."
msgstr[0] "%d 天！冠军风范。"

#: modules/critter/voice_phrases.lua:621
msgid "%d day! Is that a lot? It feels a lot!"
msgid_plural "%d days! Is that a lot? It feels a lot!"
msgstr[0] "%d 天！很多吗？感觉好多！"

#: modules/critter/voice_phrases.lua:358
msgid "%d day! More consistent than me."
msgid_plural "%d days! More consistent than me."
msgstr[0] "%d 天！比我还有恒心。"

#: modules/critter/voice_phrases.lua:446
msgid "%d day. Centuries start like this."
msgid_plural "%d days. Centuries start like this."
msgstr[0] "%d 天。世纪也是这样开始的。"

#: modules/critter/voice_phrases.lua:533
msgid "%d day. Data at last."
msgid_plural "%d days. Data at last."
msgstr[0] "%d 天。终于有数据了。"

