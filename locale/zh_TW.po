#: modules/critter/dialog.lua:48
msgid "Not now"
msgstr "下次吧"

#: modules/critter/dialog.lua:53
msgid "You've opened every book you own."
msgstr "你的每本書都開啟過了。"

#: modules/critter/dialog.lua:54
msgid "Impressive. And a bit worrying."
msgstr "厲害。也有點讓人擔心。"

#: modules/critter/dialog.lua:56
msgid "Not one unopened book. Show-off."
msgstr "一本沒開過的都沒有。真會炫。"

#: modules/critter/dialog.lua:57
msgid "Every book opened! Look at you!"
msgstr "每本都開啟過！你真行！"

#: modules/critter/dialog.lua:58
msgid "You've opened them all. I'm so proud."
msgstr "你全都開啟過了。我好驕傲。"

#: modules/critter/dialog.lua:65
msgid "Okay. They'll wait."
msgstr "好吧。它們會等你的。"

#: modules/critter/dialog.lua:67
msgid "Fine. The books can wait. So can I."
msgstr "行吧。書可以等，我也可以。"

#: modules/critter/dialog.lua:68
msgid "No rush. The shelf isn't going anywhere."
msgstr "不急。書架又不會跑。"

#: modules/critter/dialog.lua:69
msgid "Whenever you're ready."
msgstr "等你準備好再說。"

#: modules/critter/dialog.lua:79
msgid "Psst, %s. Can I ask you something?"
msgstr "噓，%s。能問你個事嗎？"

#: modules/critter/dialog.lua:81
msgid "Psst. Can I ask you something?"
msgstr "噓。能問你個事嗎？"

#: modules/critter/dialog.lua:85
msgid "Of course."
msgstr "當然。"

#: modules/critter/dialog.lua:88
msgid "When you close a book, do the characters wait?"
msgstr "合上書以後，書裡的人會等你嗎？"

#: modules/critter/dialog.lua:89
msgid "I'd hate to keep them waiting."
msgstr "我可不想讓他們久等。"

#: modules/critter/dialog.lua:91
msgid "Can I stay up while you read tonight?"
msgstr "今晚你讀書時，我能熬夜陪你嗎？"

#: modules/critter/dialog.lua:96
msgid "Is it about books?"
msgstr "跟書有關嗎？"

#: modules/critter/dialog.lua:99
msgid "Everything is about books."
msgstr "什麼都跟書有關。"

#: modules/critter/dialog.lua:100
msgid "Eventually."
msgstr "早晚的事。"

#: modules/critter/dialog.lua:103
msgid "Only a small one."
msgstr "就一個小問題。"

#: modules/critter/dialog.lua:106
msgid "I only have small ones."
msgstr "我只有小問題。"

#: modules/critter/dialog.lua:107
msgid "Look at me."
msgstr "你看看我這個頭。"

#: modules/critter/dialog.lua:110
msgid "Not now."
msgstr "現在不行。"

#: modules/critter/dialog.lua:113
msgid "Saving it for later, then."
msgstr "那就留著以後問。"

#: modules/critter/dialog.lua:115
msgid "Fine. It'll keep."
msgstr "行吧。反正它跑不了。"

#: modules/critter/dialog.lua:122
msgid "Do you think books get lonely?"
msgstr "你覺得書會寂寞嗎？"

#: modules/critter/dialog.lua:125
msgid "Do you get lonely?"
msgstr "你會寂寞嗎？"

#: modules/critter/dialog.lua:128
msgid "Not when you're reading."
msgstr "你在讀書時就不會。"

#: modules/critter/dialog.lua:129
msgid "I can hear the pages."
msgstr "我能聽見翻頁聲。"

#: modules/critter/dialog.lua:131
msgid "A little. Thanks for asking."
msgstr "有一點。謝謝你問。"

#: modules/critter/dialog.lua:135
msgid "The unread ones, maybe."
msgstr "沒讀過的那些，也許會。"

#: modules/critter/dialog.lua:138
msgid "I visit them at night."
msgstr "我晚上會去看看它們。"

#: modules/critter/dialog.lua:139
msgid "Someone has to."
msgstr "總得有人去。"

#: modules/critter/dialog.lua:141
msgid "Then let's pick one to visit."
msgstr "那我們挑一本去看看吧。"

#: modules/critter/dialog.lua:142
msgid "Great. Now I'll worry all night."
msgstr "好極了。這下我要擔心一整晚了。"

#: modules/critter/dialog.lua:147
msgid "Mine are well looked after."
msgstr "我的書都被照顧得很好。"

#: modules/critter/dialog.lua:150
msgid "I've noticed. Not a speck of dust."
msgstr "看出來了。一點灰都沒有。"

#: modules/critter/dialog.lua:151
msgid "Almost."
msgstr "差不多吧。"

#: modules/critter/dialog.lua:154
msgid "Books don't have feelings."
msgstr "書又沒有感情。"

#: modules/critter/dialog.lua:157
msgid "Tell that to the ending of that one book."
msgstr "這話你去跟那本書的結局說。"

#: modules/critter/dialog.lua:158
msgid "You know which one."
msgstr "你知道是哪本。"

#: modules/critter/dialog.lua:160
msgid "Shh. They can hear you."
msgstr "噓。它們聽得見。"

#: modules/critter/dialog.lua:167
msgid "I found something between the pages."
msgstr "我在書頁間發現了個東西。"

#: modules/critter/dialog.lua:170
msgid "What was it?"
msgstr "是什麼？"

#: modules/critter/dialog.lua:173
msgid "An old bus ticket."
msgstr "一張舊公車票。"

#: modules/critter/dialog.lua:174
msgid "This book has been places."
msgstr "這本書去過不少地方。"

#: modules/critter/dialog.lua:177
msgid "Was it my bookmark?"
msgstr "是我的書籤嗎？"

#: modules/critter/dialog.lua:180
msgid "Oh. I was using it as a blanket."
msgstr "哦。我拿它當被子蓋了。"

#: modules/critter/dialog.lua:181
msgid "I'll give it back. Warm."
msgstr "會還你的。還熱乎著。"

#: modules/critter/dialog.lua:183
msgid "Yes. I'll sleep on the cover, then."
msgstr "是的。那我只好睡封面上了。"

#: modules/critter/dialog.lua:188
msgid "Leave it where it is."
msgstr "就放那裡吧。"

#: modules/critter/dialog.lua:191
msgid "Done. It was holding someone's place."
msgstr "好了。它在替誰記著讀到哪裡。"

#: modules/critter/dialog.lua:194
msgid "Throw it away."
msgstr "扔掉吧。"

#: modules/critter/dialog.lua:197
msgid "Never. Things in books are clues."
msgstr "絕不。書裡的東西都是線索。"

#: modules/critter/dialog.lua:203
msgid "If I were in a book, what kind would it be?"
msgstr "如果我在書裡，會是哪種書？"

#: modules/critter/dialog.lua:206
msgid "An adventure."
msgstr "冒險故事。"

#: modules/critter/dialog.lua:209
msgid "Small critter, tall shelf, very long ladder."
msgstr "小不點，高書架，超長的梯子。"

#: modules/critter/dialog.lua:211
msgid "A map! A sword! A tiny backpack!"
msgstr "地圖！寶劍！小揹包！"

#: modules/critter/dialog.lua:215
msgid "A cosy one."
msgstr "溫馨的那種。"

#: modules/critter/dialog.lua:218
msgid "Tea, a blanket and nothing bad happening."
msgstr "一杯茶，一條毯子，什麼壞事都不發生。"

#: modules/critter/dialog.lua:219
msgid "Perfect."
msgstr "完美。"

#: modules/critter/dialog.lua:221
msgid "A cosy one. Mostly naps."
msgstr "溫馨的那種。主要是打盹。"

#: modules/critter/dialog.lua:225
msgid "A mystery."
msgstr "推理故事。"

#: modules/critter/dialog.lua:228
msgid "The case of the missing bookmark."
msgstr "書籤失蹤案。"

#: modules/critter/dialog.lua:229
msgid "I have a suspect."
msgstr "我心裡有個嫌疑人。"

#: modules/critter/dialog.lua:232
msgid "A very short one."
msgstr "很短很短的那種。"

#: modules/critter/dialog.lua:235
msgid "Short books are the best ones."
msgstr "短書才是最好的書。"

#: modules/critter/dialog.lua:236
msgid "Ask anyone my size."
msgstr "不信問問跟我一樣小的。"

#: modules/critter/dialog.lua:242
msgid "Where do you like to read the most?"
msgstr "你最喜歡在哪裡讀書？"

#: modules/critter/dialog.lua:245
msgid "Anywhere I can."
msgstr "哪裡都行。"

#: modules/critter/dialog.lua:248
msgid "Queues, buses, kitchens. I've seen you."
msgstr "排隊、坐車、廚房，我都看見了。"

#: modules/critter/dialog.lua:250
msgid "That's my favourite kind of reader."
msgstr "我最喜歡這樣的讀者。"

#: modules/critter/dialog.lua:254
msgid "On the go."
msgstr "在路上。"

#: modules/critter/dialog.lua:257
msgid "Reading and travelling at once."
msgstr "一邊讀書一邊旅行。"

#: modules/critter/dialog.lua:258
msgid "Twice the places."
msgstr "一次去兩個地方。"

#: modules/critter/dialog.lua:261
msgid "On the sofa."
msgstr "在沙發上。"

#: modules/critter/dialog.lua:264
msgid "Sofas were invented for books."
msgstr "沙發就是為讀書發明的。"

#: modules/critter/dialog.lua:265
msgid "Sitting came later."
msgstr "坐著是後來才有的用途。"

#: modules/critter/dialog.lua:268
msgid "In bed."
msgstr "在床上。"

#: modules/critter/dialog.lua:271
msgid "Careful. Books fall on faces."
msgstr "小心，書會砸到臉上。"

#: modules/critter/dialog.lua:272
msgid "I speak from experience."
msgstr "我是過來人。"

#: modules/critter/dialog.lua:278
msgid "Be honest: do you read the last page first?"
msgstr "說實話：你會先看最後一頁嗎？"

#: modules/critter/dialog.lua:281
msgid "Never!"
msgstr "絕不！"

#: modules/critter/dialog.lua:284
msgid "A purist. I knew I liked you."
msgstr "原教旨讀者。我就知道我喜歡你。"

#: modules/critter/dialog.lua:286
msgid "Good. Some rules matter."
msgstr "很好。有些規矩得守。"

#: modules/critter/dialog.lua:287
msgid "I knew it. The good kind of reader."
msgstr "我就知道。是好讀者。"

#: modules/critter/dialog.lua:291
msgid "Only when I'm nervous."
msgstr "只在緊張的時候。"

#: modules/critter/dialog.lua:294
msgid "Same. I check that the dog survives."
msgstr "我也是。我會先確認狗狗活著。"

#: modules/critter/dialog.lua:295
msgid "Every time."
msgstr "每次都是。"

#: modules/critter/dialog.lua:298
msgid "Sometimes."
msgstr "有時候。"

#: modules/critter/dialog.lua:301
msgid "Your secret is safe with the shelf."
msgstr "你的秘密書架替你保守。"

#: modules/critter/dialog.lua:304
msgid "Always."
msgstr "一直都是。"

#: modules/critter/dialog.lua:307
msgid "Bold. You like to know who makes it."
msgstr "膽子真大。你想先知道誰能活下來。"

#: modules/critter/dialog.lua:308
msgid "I won't tell anyone."
msgstr "我不會告訴別人的。"

#: modules/critter/dialog.lua:310
msgid "Chaos. I respect it."
msgstr "隨心所欲。我尊重。"

#: modules/critter/dialog.lua:319
msgid "Morning! How did you sleep?"
msgstr "早上好！睡得怎麼樣？"

#: modules/critter/dialog.lua:320
msgid "How's the afternoon going?"
msgstr "下午過得怎麼樣？"

#: modules/critter/dialog.lua:321
msgid "How was your day?"
msgstr "今天過得怎麼樣？"

#: modules/critter/dialog.lua:322
msgid "Still up? How was your day?"
msgstr "還沒睡？今天過得怎麼樣？"

#: modules/critter/dialog.lua:326
msgid "Pretty good."
msgstr "挺好的。"

#: modules/critter/dialog.lua:329
msgid "Good. Let's keep it that way."
msgstr "很好。繼續保持。"

#: modules/critter/dialog.lua:330
msgid "A chapter helps."
msgstr "讀一章會更好。"

#: modules/critter/dialog.lua:332
msgid "I had a feeling it would be."
msgstr "我就覺得會是這樣。"

#: modules/critter/dialog.lua:337
msgid "Could be better."
msgstr "還可以更好。"

#: modules/critter/dialog.lua:340
msgid "Then let's end it with a good chapter."
msgstr "那就用一個好章節收尾吧。"

#: modules/critter/dialog.lua:341
msgid "Books are good at that."
msgstr "書最擅長這個了。"

#: modules/critter/dialog.lua:343
msgid "Then you get the comfiest book tonight."
msgstr "那今晚你就讀最舒服的那本。"

#: modules/critter/dialog.lua:348
msgid "Tiring."
msgstr "好累。"

#: modules/critter/dialog.lua:351
msgid "Then read something easy."
msgstr "那就讀點輕鬆的。"

#: modules/critter/dialog.lua:352
msgid "Nothing with maps."
msgstr "別讀帶地圖的。"

#: modules/critter/dialog.lua:355
msgid "I'd rather not talk."
msgstr "我不太想聊。"

#: modules/critter/dialog.lua:358
msgid "Okay. I'll just sit here."
msgstr "好。我就在這裡坐著。"

#: modules/critter/dialog.lua:359
msgid "Quietly."
msgstr "安安靜靜地。"

#: modules/critter/dialog.lua:367
msgid "It's %s. Reading day, surely?"
msgstr "今天是%s。肯定是讀書日吧？"

#: modules/critter/dialog.lua:369
msgid "It's %s. Any reading planned?"
msgstr "今天是%s。打算讀點什麼嗎？"

#: modules/critter/dialog.lua:373
msgid "Every day is a reading day."
msgstr "每天都是讀書日。"

#: modules/critter/dialog.lua:376
msgid "Correct. You get a gold star."
msgstr "答對了。獎勵你一顆金星。"

#: modules/critter/dialog.lua:377
msgid "I'm out of stars. Imagine one."
msgstr "金星用完了。你就想象一顆吧。"

#: modules/critter/dialog.lua:379
msgid "Correct. Don't get smug."
msgstr "答對了。別得意。"

#: modules/critter/dialog.lua:383
msgid "Yes, a few chapters."
msgstr "是的，讀幾章。"

#: modules/critter/dialog.lua:386
msgid "Perfect. I won't look."
msgstr "完美。我不偷看。"

#: modules/critter/dialog.lua:387
msgid "I'll look."
msgstr "我會偷看的。"

#: modules/critter/dialog.lua:390
msgid "If I find the time."
msgstr "有空的話。"

#: modules/critter/dialog.lua:393
msgid "Ten minutes count. I checked."
msgstr "十分鐘也算數。我查過了。"

#: modules/critter/dialog.lua:394
msgid "I'm the one who counts."
msgstr "數數的就是我。"

#: modules/critter/dialog.lua:396
msgid "Ten minutes count. Even sleepy ones."
msgstr "十分鐘也算數。犯困的也算。"

#: modules/critter/dialog.lua:401 modules/critter/dialog.lua:583
msgid "Not today."
msgstr "今天不讀。"

#: modules/critter/dialog.lua:404
msgid "That's allowed. Books are patient."
msgstr "可以的。書很有耐心。"

#: modules/critter/dialog.lua:405
msgid "So am I. Mostly."
msgstr "我也是。大多數時候。"

#: modules/critter/dialog.lua:413
msgid "Our streak is at %d day. No pressure."
msgid_plural "Our streak is at %d days. No pressure."
msgstr[0] "我們已經連續閱讀 %d 天了。沒壓力哦。"
msgstr[1] "我們已經連續閱讀 %d 天了。沒壓力哦。"

#: modules/critter/dialog.lua:418
msgid "Let's keep it going."
msgstr "繼續保持吧。"

#: modules/critter/dialog.lua:421
msgid "That's the spirit. I'll keep count."
msgstr "就是這股勁兒。我幫你記著。"

#: modules/critter/dialog.lua:422
msgid "I love counting."
msgstr "我最喜歡數數了。"

#: modules/critter/dialog.lua:425 modules/critter/dialog.lua:427
msgid "Day %d, here we come!"
msgstr "第 %d 天，我們來了！"

#: modules/critter/dialog.lua:428
msgid "Good. I'd hate to start over."
msgstr "很好。我可不想從頭再來。"

#: modules/critter/dialog.lua:433
msgid "No pressure? Really?"
msgstr "沒壓力？真的？"

#: modules/critter/dialog.lua:436
msgid "None at all. I'm just writing it on the wall."
msgstr "完全沒有。我只是把它寫在牆上。"

#: modules/critter/dialog.lua:437
msgid "In big letters."
msgstr "用大字。"

#: modules/critter/dialog.lua:440
msgid "What if I miss a day?"
msgstr "要是我漏了一天呢？"

#: modules/critter/dialog.lua:443
msgid "Then we start again. I'll still be here."
msgstr "那就重新開始。我還會在這裡。"

#: modules/critter/dialog.lua:446
msgid "Stop counting."
msgstr "別數了。"

#: modules/critter/dialog.lua:449
msgid "Sorry. Counting is how I show I care."
msgstr "抱歉。數數是我關心你的方式。"

#: modules/critter/dialog.lua:455
msgid "The streak took a little break."
msgstr "連續閱讀稍微歇了一下。"

#: modules/critter/dialog.lua:458
msgid "Let's start again today."
msgstr "今天重新開始吧。"

#: modules/critter/dialog.lua:461
msgid "Day one. My favourite kind."
msgstr "第一天。我最喜歡的那種。"

#: modules/critter/dialog.lua:462
msgid "Everything starts here."
msgstr "一切都從這裡開始。"

#: modules/critter/dialog.lua:464
msgid "Day one. Again. Fine."
msgstr "第一天。又來。行吧。"

#: modules/critter/dialog.lua:465
msgid "Day one with you. My favourite."
msgstr "和你一起的第一天。我最喜歡。"

#: modules/critter/dialog.lua:470
msgid "I'll be back soon."
msgstr "我很快就回來。"

#: modules/critter/dialog.lua:473
msgid "I'll keep your place."
msgstr "我幫你記著讀到哪裡。"

#: modules/critter/dialog.lua:474
msgid "I'm good at that."
msgstr "這個我很拿手。"

#: modules/critter/dialog.lua:477
msgid "It needed a rest."
msgstr "它需要休息一下。"

#: modules/critter/dialog.lua:480
msgid "Fair. Even streaks get tired."
msgstr "也對。連續閱讀也會累。"

#: modules/critter/dialog.lua:481
msgid "I nap all the time."
msgstr "我天天打盹。"

#: modules/critter/dialog.lua:484
msgid "Don't remind me."
msgstr "別提了。"

#: modules/critter/dialog.lua:487
msgid "Forgotten. What streak?"
msgstr "忘了。什麼連續閱讀？"

#: modules/critter/dialog.lua:495
msgid "%d book this year. How's the goal looking?"
msgid_plural "%d books this year. How's the goal looking?"
msgstr[0] "今年讀了 %d 本書。目標進展如何？"
msgstr[1] "今年讀了 %d 本書。目標進展如何？"

#: modules/critter/dialog.lua:500
msgid "Right on track."
msgstr "完全按計劃。"

#: modules/critter/dialog.lua:503
msgid "I knew it. I've seen the shelf."
msgstr "我就知道。我看過書架了。"

#: modules/critter/dialog.lua:505
msgid "On track. Quietly proud of you."
msgstr "按計劃進行。我默默為你驕傲。"

#: modules/critter/dialog.lua:506
msgid "On track! I'm telling the whole shelf."
msgstr "按計劃進行！我要告訴整個書架。"

#: modules/critter/dialog.lua:510
msgid "What should I read next?"
msgstr "我接下來該讀什麼？"

#: modules/critter/dialog.lua:513
msgid "A bit behind."
msgstr "有點落後。"

#: modules/critter/dialog.lua:516
msgid "There's still time. Short books count."
msgstr "還有時間。短書也算數。"

#: modules/critter/dialog.lua:517
msgid "I checked the rules."
msgstr "我查過規則了。"

#: modules/critter/dialog.lua:520
msgid "I forgot I had one."
msgstr "我都忘了我還有目標。"

#: modules/critter/dialog.lua:523
msgid "It didn't forget you."
msgstr "它可沒忘了你。"

#: modules/critter/dialog.lua:524
msgid "Goals are like that."
msgstr "目標就是這樣。"

#: modules/critter/dialog.lua:532
msgid "%d page today. Where did it take you?"
msgid_plural "%d pages today. Where did they take you?"
msgstr[0] "今天讀了 %d 頁。它們帶你去了哪裡？"
msgstr[1] "今天讀了 %d 頁。它們帶你去了哪裡？"

#: modules/critter/dialog.lua:537
msgid "Somewhere far away."
msgstr "很遠的地方。"

#: modules/critter/dialog.lua:540
msgid "Lucky. I've never left this shelf."
msgstr "真好。我從沒離開過這個書架。"

#: modules/critter/dialog.lua:541
msgid "Tell me about it sometime."
msgstr "改天講給我聽吧。"

#: modules/critter/dialog.lua:543
msgid "Lucky. I stayed here. On the shelf."
msgstr "真好。我留在這裡了。書架上。"

#: modules/critter/dialog.lua:548
msgid "Can't say. Spoilers."
msgstr "不能說。會爆雷。"

#: modules/critter/dialog.lua:551
msgid "Fair. I'll find out myself one day."
msgstr "也對。總有一天我自己去看。"

#: modules/critter/dialog.lua:554
msgid "Nowhere exciting yet."
msgstr "暫時還沒什麼精彩的。"

#: modules/critter/dialog.lua:557
msgid "Some chapters are corridors."
msgstr "有些章節就像走廊。"

#: modules/critter/dialog.lua:558
msgid "They lead somewhere."
msgstr "總會通向某個地方。"

#: modules/critter/dialog.lua:564
msgid "No reading yet today. Shall we fix that?"
msgstr "今天還沒讀書。要不要補上？"

#: modules/critter/dialog.lua:567
msgid "Yes, right now."
msgstr "好，現在就讀。"

#: modules/critter/dialog.lua:570
msgid "Wonderful. I'll hold the lamp."
msgstr "太好了。我來舉燈。"

#: modules/critter/dialog.lua:572
msgid "Yes! Lamp on. Pages ready."
msgstr "好！燈已開，書頁就位。"

#: modules/critter/dialog.lua:576
msgid "Later tonight."
msgstr "今晚晚些時候。"

#: modules/critter/dialog.lua:579
msgid "I'll remind you."
msgstr "我會提醒你的。"

#: modules/critter/dialog.lua:580
msgid "Gently."
msgstr "輕輕地。"

#: modules/critter/dialog.lua:586
msgid "That's fine. Rest days count too."
msgstr "沒關係。休息日也算數。"

#: modules/critter/dialog.lua:589
msgid "Stop nagging."
msgstr "別嘮叨了。"

#: modules/critter/dialog.lua:592
msgid "Sorry. I just like it when you read."
msgstr "抱歉。我就是喜歡看你讀書。"

#: modules/critter/dialog.lua:600
msgid "Want me to pick your next book?"
msgstr "要我幫你挑下一本書嗎？"

#: modules/critter/dialog.lua:603
msgid "Yes, pick one"
msgstr "好，挑一本"

#: modules/critter/dialog.lua:617
msgid "Challenge accepted"
msgstr "接受挑戰"

#: modules/critter/dialog.lua:620
msgid "Deal. I'll keep an eye on it."
msgstr "一言為定。我會盯著的。"

#: modules/critter/dialog.lua:621
msgid "A friendly eye."
msgstr "友善地盯著。"

#: modules/critter/dialog.lua:623
msgid "Bold. Let's see."
msgstr "有膽量。看你的了。"

#: modules/critter/dialog.lua:624
msgid "Yes! You've got this!"
msgstr "好耶！你一定行！"

#: modules/critter/dialog.lua:625
msgid "I knew you'd say yes."
msgstr "我就知道你會答應。"

#: modules/critter/dialog.lua:629
msgid "Maybe later"
msgstr "以後再說"

#: modules/critter/dialog.lua:632
msgid "The offer stands until midnight."
msgstr "這個提議到午夜前都有效。"

#: modules/critter/dialog.lua:634
msgid "Suit yourself."
msgstr "隨你吧。"

#: modules/critter/dialog.lua:635
msgid "Of course. No pressure."
msgstr "當然。沒壓力。"

#: modules/critter/dialog.lua:644
msgid "On it!"
msgstr "這就去！"

#: modules/critter/dialog.lua:647
msgid "Go! I'll be here, counting."
msgstr "去吧！我在這裡幫你數著。"

#: modules/critter/dialog.lua:649
msgid "Less talking. More reading."
msgstr "少說話，多讀書。"

#: modules/critter/dialog.lua:650
msgid "You're unstoppable today."
msgstr "你今天勢不可擋。"

#: modules/critter/dialog.lua:654
msgid "Tough one…"
msgstr "有點難……"

#: modules/critter/dialog.lua:657
msgid "One page at a time. They all count."
msgstr "一頁一頁來。每頁都算數。"

#: modules/critter/dialog.lua:659
msgid "You can do it. One page at a time."
msgstr "你能行的。一頁一頁來。"

#: modules/critter/dialog.lua:660
msgid "Then slowly. Very slowly."
msgstr "那就慢慢來。非常慢地來。"

#: modules/critter/dialog.lua:736
msgid "Try “%s”, by %s."
msgstr "試試《%s》，作者 %s。"

#: modules/critter/dialog.lua:737
msgid "Try “%s”."
msgstr "試試《%s》。"

#: modules/critter/dialog.lua:740
msgid "Open it"
msgstr "開啟它"

#: modules/critter/dialog.lua:741
msgid "Another one"
msgstr "換一本"

#: modules/critter/module_critter.lua:741
msgid "Decorations"
msgstr "裝飾"

#: modules/critter/module_critter.lua:803
msgid "Bubble style"
msgstr "氣泡樣式"

#: modules/critter/module_critter.lua:805
msgid "Pixel"
msgstr "畫素"

#: modules/critter/module_critter.lua:806
msgid "Smooth"
msgstr "平滑"

#: modules/critter/module_critter.lua:855
msgid "React to events"
msgstr "對事件做出反應"

#: modules/critter/reaction_lines.lua:60
msgid "%s, finished!"
msgstr "《%s》，讀完了！"

#: modules/critter/reaction_lines.lua:61 modules/critter/reaction_lines.lua:83
msgid "Take a bow. I'll hold the applause."
msgstr "鞠個躬吧。掌聲我先替你攢著。"

#: modules/critter/reaction_lines.lua:63
msgid "You finished %s."
msgstr "你讀完了《%s》。"

#: modules/critter/reaction_lines.lua:64 modules/critter/reaction_lines.lua:86
msgid "I'm not crying. It's dust."
msgstr "我沒哭。是灰塵。"

#: modules/critter/reaction_lines.lua:66
msgid "%s is over. Good for you."
msgstr "《%s》讀完了。挺好。"

#: modules/critter/reaction_lines.lua:67
msgid "%s! DONE! Incredible!"
msgstr "《%s》！讀完了！太厲害了！"

#: modules/critter/reaction_lines.lua:70
msgid "Another book on the done pile."
msgstr "已讀書堆又多了一本。"

#: modules/critter/reaction_lines.lua:71
msgid "%s was a good one."
msgstr "《%s》是本好書。"

#: modules/critter/reaction_lines.lua:73
msgid "A book finished. I need to lie down."
msgstr "讀完一本書。我得躺一會兒。"

#: modules/critter/reaction_lines.lua:74
msgid "A new chapter of your legend is complete!"
msgstr "你的傳奇又完成了一章！"

#: modules/critter/reaction_lines.lua:75
msgid "%s will be sung about."
msgstr "《%s》會被傳頌的。"

#: modules/critter/reaction_lines.lua:78 modules/critter/reaction_lines.lua:100
msgid "So, how did it end?"
msgstr "所以，結局怎麼樣？"

#: modules/critter/reaction_lines.lua:79
msgid "Tell me about %s. No spoilers. Okay, spoilers."
msgstr "講講《%s》吧。不許爆雷。好吧，爆雷也行。"

#: modules/critter/reaction_lines.lua:82
msgid "Book finished!"
msgstr "讀完一本書！"

#: modules/critter/reaction_lines.lua:85
msgid "You finished a book."
msgstr "你讀完了一本書。"

#: modules/critter/reaction_lines.lua:88
msgid "A book is over. Good for you."
msgstr "一本書讀完了。挺好。"

#: modules/critter/reaction_lines.lua:89
msgid "DONE! Incredible!"
msgstr "讀完了！太厲害了！"

#: modules/critter/reaction_lines.lua:92
msgid "Another one for the done pile."
msgstr "已讀書堆又多了一本。"

#: modules/critter/reaction_lines.lua:93
msgid "That was a good one."
msgstr "那是本好書。"

#: modules/critter/reaction_lines.lua:95
msgid "One more finished. I need to lie down."
msgstr "又讀完一本。我得躺一會兒。"

#: modules/critter/reaction_lines.lua:96
msgid "Another chapter of your legend is complete!"
msgstr "你的傳奇又完成了一章！"

#: modules/critter/reaction_lines.lua:97
msgid "It will be sung about."
msgstr "它會被傳頌的。"

#: modules/critter/reaction_lines.lua:101
msgid "No spoilers. Okay, spoilers."
msgstr "不許爆雷。好吧，爆雷也行。"

#: modules/critter/reaction_lines.lua:108
msgid "A quick peek?"
msgstr "偷偷看一眼？"

#: modules/critter/reaction_lines.lua:109
msgid "%d minute. A sneaky one."
msgid_plural "%d minutes. A sneaky one."
msgstr[0] "%d 分鐘。偷偷讀的。"
msgstr[1] "%d 分鐘。偷偷讀的。"

#: modules/critter/reaction_lines.lua:111
msgid "Short and sweet."
msgstr "短小精悍。"

#: modules/critter/reaction_lines.lua:112
msgid "Even a few pages count."
msgstr "幾頁也算數。"

#: modules/critter/reaction_lines.lua:114
msgid "That was short. I blinked and missed it."
msgstr "好短。我一眨眼就錯過了。"

#: modules/critter/reaction_lines.lua:115
msgid "Every page counts! Hooray for pages!"
msgstr "每一頁都算數！為書頁歡呼！"

#: modules/critter/reaction_lines.lua:118
msgid "Just a little one today."
msgstr "今天就讀了一點點。"

#: modules/critter/reaction_lines.lua:119
msgid "Little reads add up."
msgstr "讀一點點，積少成多。"

#: modules/critter/reaction_lines.lua:121
msgid "A short one. My kind of effort."
msgstr "短短一會兒。我喜歡的努力程度。"

#: modules/critter/reaction_lines.lua:122
msgid "A brief, brilliant visit to another world!"
msgstr "去另一個世界短暫而精彩的一遊！"

#: modules/critter/reaction_lines.lua:125
msgid "A page here, a page there."
msgstr "這裡一頁，那裡一頁。"

#: modules/critter/reaction_lines.lua:126
msgid "That's how libraries get built."
msgstr "圖書館就是這麼建起來的。"

#: modules/critter/reaction_lines.lua:129
msgid "%d minute of reading."
msgid_plural "%d minutes of reading."
msgstr[0] "讀了 %d 分鐘。"
msgstr[1] "讀了 %d 分鐘。"

#: modules/critter/reaction_lines.lua:130
msgid "A proper stretch."
msgstr "讀了好一陣。"

#: modules/critter/reaction_lines.lua:132
msgid "Nice little session!"
msgstr "不錯的一小段閱讀！"

#: modules/critter/reaction_lines.lua:133
msgid "The book is warm now."
msgstr "書都被你捂熱了。"

#: modules/critter/reaction_lines.lua:135
msgid "Fine. A decent session. Don't let it go to your head."
msgstr "行吧。讀得還可以。別驕傲。"

#: modules/critter/reaction_lines.lua:136
msgid "What a lovely session! Bravo!"
msgstr "多美好的閱讀時光！好棒！"

#: modules/critter/reaction_lines.lua:139
msgid "Look who's got staying power."
msgstr "看看誰這麼有耐力。"

#: modules/critter/reaction_lines.lua:140
msgid "Same time tomorrow?"
msgstr "明天同一時間？"

#: modules/critter/reaction_lines.lua:142
msgid "A decent session. I almost stayed awake."
msgstr "讀得還可以。我差點沒撐住醒著。"

#: modules/critter/reaction_lines.lua:143
msgid "A session worthy of the great libraries!"
msgstr "堪比偉大圖書館的一次閱讀！"

#: modules/critter/reaction_lines.lua:146
msgid "That was cosy."
msgstr "好愜意。"

#: modules/critter/reaction_lines.lua:147
msgid "The book and you make a good team."
msgstr "你和這本書是好搭檔。"

#: modules/critter/reaction_lines.lua:150
msgid "%d minute! Did you eat?"
msgid_plural "%d minutes! Did you eat?"
msgstr[0] "%d 分鐘！你吃飯了嗎？"
msgstr[1] "%d 分鐘！你吃飯了嗎？"

#: modules/critter/reaction_lines.lua:151
msgid "Drink some water, hero."
msgstr "喝點水吧，英雄。"

#: modules/critter/reaction_lines.lua:153
msgid "Marathon reader!"
msgstr "馬拉松讀者！"

#: modules/critter/reaction_lines.lua:154
msgid "%d minute without surfacing."
msgid_plural "%d minutes without surfacing."
msgstr[0] "%d 分鐘沒抬過頭。"
msgstr[1] "%d 分鐘沒抬過頭。"

#: modules/critter/reaction_lines.lua:156
msgid "A marathon. I'm tired just watching."
msgstr "一場馬拉松。我光看著都累了。"

#: modules/critter/reaction_lines.lua:157
msgid "A MARATHON! You're unstoppable!"
msgstr "馬拉松！你勢不可擋！"

#: modules/critter/reaction_lines.lua:160
msgid "The world can wait."
msgstr "世界可以等一等。"

#: modules/critter/reaction_lines.lua:161
msgid "The book clearly deserved it."
msgstr "這本書顯然值得。"

#: modules/critter/reaction_lines.lua:163
msgid "All that reading. Wake me when it's over."
msgstr "讀了這麼久。結束了叫醒我。"

#: modules/critter/reaction_lines.lua:164
msgid "An epic voyage! The sagas will remember it!"
msgstr "史詩般的遠航！史書會記住它！"

#: modules/critter/reaction_lines.lua:167
msgid "Was it that good?"
msgstr "有那麼好看嗎？"

#: modules/critter/reaction_lines.lua:168
msgid "You must tell me everything."
msgstr "你得全都講給我聽。"

#: modules/critter/reaction_lines.lua:175
msgid "I'm at %d%%."
msgstr "我只剩 %d%% 了。"

#: modules/critter/reaction_lines.lua:176
msgid "Not to be dramatic, but find a charger."
msgstr "不是我誇張，快去找充電器。"

#: modules/critter/reaction_lines.lua:178
msgid "Running on fumes."
msgstr "快沒電了。"

#: modules/critter/reaction_lines.lua:179
msgid "%d%% left. I'll be brave."
msgstr "還剩 %d%%。我會勇敢的。"

#: modules/critter/reaction_lines.lua:181
msgid "Low battery. Typical."
msgstr "電量低。果然。"

#: modules/critter/reaction_lines.lua:182
msgid "Battery low! Quick, adventure's calling!"
msgstr "電量低！快，冒險在召喚！"

#: modules/critter/reaction_lines.lua:185
msgid "Feeling a bit faint."
msgstr "有點頭暈。"

#: modules/critter/reaction_lines.lua:186
msgid "A charger would be lovely."
msgstr "來個充電器就好了。"

#: modules/critter/reaction_lines.lua:188
msgid "Low battery. Finally, a reason to nap."
msgstr "電量低。終於有理由打盹了。"

#: modules/critter/reaction_lines.lua:189
msgid "My light is fading! Fetch the charger, brave soul!"
msgstr "我的光芒正在消逝！勇士，快取充電器！"

#: modules/critter/reaction_lines.lua:192
msgid "Psst. The battery is low."
msgstr "噓。電量不多了。"

#: modules/critter/reaction_lines.lua:193
msgid "I didn't want to say anything."
msgstr "我本來不想說的。"

#: modules/critter/reaction_lines.lua:196
msgid "Ooh, that's nice."
msgstr "哦，好舒服。"

#: modules/critter/reaction_lines.lua:197
msgid "Slurp. Thank you."
msgstr "咕嚕。謝謝你。"

#: modules/critter/reaction_lines.lua:199
msgid "Charging. Bliss."
msgstr "充電中。真幸福。"

#: modules/critter/reaction_lines.lua:200
msgid "I'll just rest my eyes."
msgstr "我就閉目養神一下。"

#: modules/critter/reaction_lines.lua:202
msgid "Charging. About time."
msgstr "充電中。早該充了。"

#: modules/critter/reaction_lines.lua:203
msgid "Power! Glorious power!"
msgstr "電力！偉大的電力！"

#: modules/critter/reaction_lines.lua:206
msgid "You plugged me in."
msgstr "你給我插上電了。"

#: modules/critter/reaction_lines.lua:207
msgid "You're my favourite human."
msgstr "你是我最喜歡的人類。"

#: modules/critter/reaction_lines.lua:209
msgid "Charging. Wake me at 100%."
msgstr "充電中。到 100% 叫醒我。"

#: modules/critter/reaction_lines.lua:210
msgid "Energy flows! I am reborn!"
msgstr "能量湧動！我重生了！"

#: modules/critter/reaction_lines.lua:213
msgid "Snack time!"
msgstr "加餐時間！"

#: modules/critter/reaction_lines.lua:214
msgid "Electrons, my favourite."
msgstr "電子，我的最愛。"

#: modules/critter/reaction_lines.lua:221
msgid "Happy new year!"
msgstr "新年快樂！"

#: modules/critter/reaction_lines.lua:222
msgid "A whole year of unread pages awaits."
msgstr "一整年的未讀書頁在等你。"

#: modules/critter/reaction_lines.lua:224
msgid "New year, new shelf."
msgstr "新年，新書架。"

#: modules/critter/reaction_lines.lua:225
msgid "What shall we read first?"
msgstr "我們先讀什麼？"

#: modules/critter/reaction_lines.lua:227
msgid "Another year. The pile is still there."
msgstr "又一年。那堆書還在。"

#: modules/critter/reaction_lines.lua:228
msgid "HAPPY NEW YEAR! Let's read everything!"
msgstr "新年快樂！把書全讀了吧！"

#: modules/critter/reaction_lines.lua:231
msgid "Resolutions?"
msgstr "新年願望？"

#: modules/critter/reaction_lines.lua:232
msgid "Mine is to nap more. Yours?"
msgstr "我的是多打盹。你的呢？"

#: modules/critter/reaction_lines.lua:234
msgid "A new year. Wake me in January. Oh, wait."
msgstr "新年了。一月叫醒我。哦，等等。"

#: modules/critter/reaction_lines.lua:235
msgid "A new year, a new saga! Onward!"
msgstr "新的一年，新的傳奇！出發！"

#: modules/critter/reaction_lines.lua:238
msgid "The year turns like a page."
msgstr "一年就像翻過一頁。"

#: modules/critter/reaction_lines.lua:239
msgid "Let's make it a good chapter."
msgstr "讓它成為精彩的一章。"

#: modules/critter/reaction_lines.lua:242
msgid "Happy World Book Day!"
msgstr "世界讀書日快樂！"

#: modules/critter/reaction_lines.lua:243
msgid "Today we celebrate you and your shelves."
msgstr "今天為你和你的書架慶祝。"

#: modules/critter/reaction_lines.lua:245
msgid "It's World Book Day!"
msgstr "今天是世界讀書日！"

#: modules/critter/reaction_lines.lua:246
msgid "Reading today is practically mandatory."
msgstr "今天讀書幾乎是必須的。"

#: modules/critter/reaction_lines.lua:248
msgid "World Book Day. Fine. Read something."
msgstr "世界讀書日。行吧。讀點什麼。"

#: modules/critter/reaction_lines.lua:249
msgid "WORLD BOOK DAY! The best day of the year!"
msgstr "世界讀書日！一年中最棒的一天！"

#: modules/critter/reaction_lines.lua:252
msgid "A day for books, at last."
msgstr "終於，屬於書的一天。"

#: modules/critter/reaction_lines.lua:253
msgid "I've been waiting all year."
msgstr "我等了一整年。"

#: modules/critter/reaction_lines.lua:255
msgid "Book Day. A holiday for my favourite thing: sitting."
msgstr "讀書日。我最愛的事也放假了：坐著。"

#: modules/critter/reaction_lines.lua:256
msgid "Today the whole world kneels to the book!"
msgstr "今天全世界都向書致敬！"

#: modules/critter/reaction_lines.lua:259
msgid "Happy Book Day!"
msgstr "讀書日快樂！"

#: modules/critter/reaction_lines.lua:260
msgid "Go on, pick something shiny."
msgstr "去吧，挑一本亮眼的。"

#: modules/critter/reaction_lines.lua:263
msgid "%d year together!"
msgid_plural "%d years together!"
msgstr[0] "我們在一起 %d 年了！"
msgstr[1] "我們在一起 %d 年了！"

#: modules/critter/reaction_lines.lua:264
msgid "Look at us."
msgstr "看看我們。"

#: modules/critter/reaction_lines.lua:266
msgid "Happy anniversary!"
msgstr "週年快樂！"

#: modules/critter/reaction_lines.lua:267
msgid "%d year of pages and snacks."
msgid_plural "%d years of pages and snacks."
msgstr[0] "%d 年的書頁和零食。"
msgstr[1] "%d 年的書頁和零食。"

#: modules/critter/reaction_lines.lua:269
msgid "An anniversary. I suppose I'm fond of you."
msgstr "週年紀念。我想我還挺喜歡你的。"

#: modules/critter/reaction_lines.lua:270
msgid "HAPPY ANNIVERSARY! I love us!"
msgstr "週年快樂！我愛我們！"

#: modules/critter/reaction_lines.lua:273
msgid "I remember the day we met."
msgstr "我還記得我們相遇那天。"

#: modules/critter/reaction_lines.lua:274
msgid "You had a book in your hand."
msgstr "你手裡拿著一本書。"

#: modules/critter/reaction_lines.lua:276
msgid "An anniversary. Cake? No? Nap, then."
msgstr "週年紀念。蛋糕？沒有？那就打盹。"

#: modules/critter/reaction_lines.lua:277
msgid "Our story is the finest of all libraries!"
msgstr "我們的故事是所有圖書館裡最好的！"

#: modules/critter/reaction_lines.lua:280
msgid "Another lap around the sun."
msgstr "又繞太陽轉了一圈。"

#: modules/critter/reaction_lines.lua:281
msgid "Together, with books."
msgstr "一起，和書一起。"

#: modules/critter/reaction_lines.lua:284
msgid "Welcome to %s!"
msgstr "歡迎來到%s！"

#: modules/critter/reaction_lines.lua:285
msgid "A fresh month, a fresh stack."
msgstr "新的月份，新的書堆。"

#: modules/critter/reaction_lines.lua:287
msgid "%s already?"
msgstr "已經%s了？"

#: modules/critter/reaction_lines.lua:288
msgid "Time flies when you're reading."
msgstr "讀書時時間過得真快。"

#: modules/critter/reaction_lines.lua:290
msgid "%s. Another month of the same pile."
msgstr "%s。又一個月對著同一堆書。"

#: modules/critter/reaction_lines.lua:291
msgid "%s! New month, new adventures!"
msgstr "%s！新的月份，新的冒險！"

#: modules/critter/reaction_lines.lua:294
msgid "The calendar flipped a page."
msgstr "日曆翻了一頁。"

#: modules/critter/reaction_lines.lua:295
msgid "Let's see what %s brings."
msgstr "看看%s會帶來什麼。"

#: modules/critter/reaction_lines.lua:297
msgid "It's %s. I barely noticed."
msgstr "%s了。我都沒注意到。"

#: modules/critter/reaction_lines.lua:298
msgid "%s arrives! A new act begins!"
msgstr "%s來了！新的一幕開始了！"

#: modules/critter/reaction_lines.lua:301
msgid "New month, new goals."
msgstr "新的月份，新的目標。"

#: modules/critter/reaction_lines.lua:302
msgid "Or the same ones. I'm not picky."
msgstr "或者還是老目標。我不挑。"

#: modules/critter/reaction_lines.lua:309
msgid "Look who's back!"
msgstr "看看誰回來了！"

#: modules/critter/reaction_lines.lua:310
msgid "%d day away. I counted."
msgid_plural "%d days away. I counted."
msgstr[0] "離開了 %d 天。我數著呢。"
msgstr[1] "離開了 %d 天。我數著呢。"

#: modules/critter/reaction_lines.lua:312
msgid "I kept your place."
msgstr "我幫你記著讀到哪裡了。"

#: modules/critter/reaction_lines.lua:313
msgid "Right where you left it."
msgstr "就在你離開的地方。"

#: modules/critter/reaction_lines.lua:315
msgid "Oh, you remember me."
msgstr "哦，你還記得我啊。"

#: modules/critter/reaction_lines.lua:316
msgid "You're back! I missed you!"
msgstr "你回來了！我好想你！"

#: modules/critter/reaction_lines.lua:319
msgid "A short holiday?"
msgstr "短暫的假期？"

#: modules/critter/reaction_lines.lua:320
msgid "Hope the books were jealous."
msgstr "希望書們吃醋了。"

#: modules/critter/reaction_lines.lua:322
msgid "You're back. I was napping, honest."
msgstr "你回來了。我剛在打盹，真的。"

#: modules/critter/reaction_lines.lua:323
msgid "The wanderer returns to the library!"
msgstr "流浪者回到了圖書館！"

#: modules/critter/reaction_lines.lua:326
msgid "Welcome back!"
msgstr "歡迎回來！"

#: modules/critter/reaction_lines.lua:327
msgid "The shelves missed you."
msgstr "書架們想你了。"

#: modules/critter/reaction_lines.lua:330
msgid "%d day! Where were you?"
msgid_plural "%d days! Where were you?"
msgstr[0] "%d 天！你去哪裡了？"
msgstr[1] "%d 天！你去哪裡了？"

#: modules/critter/reaction_lines.lua:331
msgid "The books were worried."
msgstr "書們都擔心了。"

#: modules/critter/reaction_lines.lua:333
msgid "It's been a while."
msgstr "好久不見。"

#: modules/critter/reaction_lines.lua:334
msgid "I dusted the shelves twice."
msgstr "我把書架撣了兩遍灰。"

#: modules/critter/reaction_lines.lua:336
msgid "So you remember where I live."
msgstr "原來你還記得我住哪裡。"

#: modules/critter/reaction_lines.lua:337
msgid "You're back! Best day ever!"
msgstr "你回來了！最棒的一天！"

#: modules/critter/reaction_lines.lua:340
msgid "What did I miss?"
msgstr "我錯過了什麼？"

#: modules/critter/reaction_lines.lua:341
msgid "Tell me everything. Slowly."
msgstr "全都告訴我。慢慢說。"

#: modules/critter/reaction_lines.lua:343
msgid "You're back. Finally. I got so bored I napped."
msgstr "你終於回來了。我無聊得都睡著了。"

#: modules/critter/reaction_lines.lua:344
msgid "The reader returns! Let the feast begin!"
msgstr "讀者回來了！開席！"

#: modules/critter/reaction_lines.lua:347
msgid "I started talking to the bookcase."
msgstr "我開始跟書櫃聊天了。"

#: modules/critter/reaction_lines.lua:348
msgid "It's a good listener."
msgstr "它很會傾聽。"

#: modules/critter/reaction_lines.lua:351
msgid "%d day! I thought you'd moved."
msgid_plural "%d days! I thought you'd moved."
msgstr[0] "%d 天！我以為你搬走了。"
msgstr[1] "%d 天！我以為你搬走了。"

#: modules/critter/reaction_lines.lua:352
msgid "Welcome home."
msgstr "歡迎回家。"

#: modules/critter/reaction_lines.lua:354
msgid "You came back."
msgstr "你回來了。"

#: modules/critter/reaction_lines.lua:355 modules/critter/reaction_lines.lua:408
msgid "I never doubted you. Much."
msgstr "我從沒懷疑過你。基本沒有。"

#: modules/critter/reaction_lines.lua:357
msgid "A month. I kept busy. Mostly sulking."
msgstr "一個月。我挺忙的。主要在生悶氣。"

#: modules/critter/reaction_lines.lua:358
msgid "YOU'RE BACK! Confetti, everyone!"
msgstr "你回來了！大家撒彩帶！"

#: modules/critter/reaction_lines.lua:361
msgid "It's been so long."
msgstr "好久好久了。"

#: modules/critter/reaction_lines.lua:362
msgid "The dust and I have become friends."
msgstr "我和灰塵都成朋友了。"

#: modules/critter/reaction_lines.lua:364
msgid "You're back. I slept through half of it."
msgstr "你回來了。我睡過了一半。"

#: modules/critter/reaction_lines.lua:365
msgid "The hero returns after a long quest!"
msgstr "英雄結束漫長的遠征歸來！"

#: modules/critter/reaction_lines.lua:368
msgid "Welcome back, stranger!"
msgstr "歡迎回來，陌生人！"

#: modules/critter/reaction_lines.lua:369
msgid "Shall we pick up where we left off?"
msgstr "我們從上次停下的地方繼續？"

#: modules/critter/reaction_lines.lua:407
msgid "Challenge met!"
msgstr "挑戰完成！"

#: modules/critter/reaction_lines.lua:410
msgid "Fine. You did it. Don't expect a parade."
msgstr "行吧。你做到了。別指望遊行慶祝。"

#: modules/critter/reaction_lines.lua:411
msgid "Challenge crushed! Take a bow, champion!"
msgstr "挑戰完勝！鞠個躬吧，冠軍！"

#: modules/critter/reaction_lines.lua:414
msgid "You said you would, and you did."
msgstr "你說到做到。"

#: modules/critter/reaction_lines.lua:415
msgid "That's the best kind of promise."
msgstr "這才是最好的承諾。"

#: modules/critter/reaction_lines.lua:417
msgid "Done and dusted."
msgstr "搞定收工。"

#: modules/critter/reaction_lines.lua:418
msgid "Shall I pick a harder one tomorrow?"
msgstr "明天要不要來個難點的？"

#: modules/critter/reaction_lines.lua:420
msgid "Done. Now I need a nap."
msgstr "搞定。現在我得打個盹。"

#: modules/critter/reaction_lines.lua:421
msgid "Done and dusted! Look at you go!"
msgstr "搞定收工！瞧你多厲害！"

#: modules/critter/reaction_lines.lua:424
msgid "A small goal, a big grin."
msgstr "小目標，大笑臉。"

#: modules/critter/reaction_lines.lua:425
msgid "I'm keeping count, you know."
msgstr "我可一直在記著哦。"

#: modules/critter/talk.lua:117
msgid "Say something else…"
msgstr "換個話題……"

#: modules/reading_stats/module_reading_stats.lua:409 modules/reading_stats/module_reading_stats.lua:413
msgid "%dm"
msgstr "%d分鐘"

#: modules/reading_stats/module_reading_stats.lua:411
msgid "%dh %dm"
msgstr "%d小時%d分"

#: modules/reading_stats/module_reading_stats.lua:412
msgid "%dh"
msgstr "%d小時"

#: modules/reading_stats/module_reading_stats.lua:422
msgid "AM"
msgstr "上午"

#: modules/reading_stats/module_reading_stats.lua:422
msgid "PM"
msgstr "下午"

#: modules/reading_stats/module_reading_stats.lua:443
msgid "Reading time today"
msgstr "今日閱讀時長"

#: modules/reading_stats/module_reading_stats.lua:444
msgid "Pages read today"
msgstr "今日閱讀頁數"

#: modules/reading_stats/module_reading_stats.lua:445
msgid "Reading time this week"
msgstr "本週閱讀時長"

#: modules/reading_stats/module_reading_stats.lua:446
msgid "Pages read this week"
msgstr "本週閱讀頁數"

#: modules/reading_stats/module_reading_stats.lua:447
msgid "Reading time this year"
msgstr "今年閱讀時長"

#: modules/reading_stats/module_reading_stats.lua:447
msgid "This year"
msgstr "今年"

#: modules/reading_stats/module_reading_stats.lua:447
msgid "of reading this year"
msgstr "今年閱讀時長"

#: modules/reading_stats/module_reading_stats.lua:448
msgid "Daily average, last 7 days"
msgstr "日平均（近 7 天）"

#: modules/reading_stats/module_reading_stats.lua:449
msgid "Pages per day, last 7 days"
msgstr "每日頁數（近 7 天）"

#: modules/reading_stats/module_reading_stats.lua:450
msgid "Reading time this month"
msgstr "本月閱讀時長"

#: modules/reading_stats/module_reading_stats.lua:451
msgid "Pages read this month"
msgstr "本月閱讀頁數"

#: modules/reading_stats/module_reading_stats.lua:452
msgid "Total reading time"
msgstr "總閱讀時長"

#: modules/reading_stats/module_reading_stats.lua:453 screens/sui_stats_windows.lua:1908
msgid "Books finished"
msgstr "讀完的書"

